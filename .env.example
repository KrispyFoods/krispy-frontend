# Copy to .env and fill in. Never commit real values.
MONGODB_URI=
# cloudinary://<api_key>:<api_secret>@<cloud_name>; the key needs upload (create) and delete permission
CLOUDINARY_URL=
# 6-digit PIN for /admin. Leave empty to block all logins.
ADMIN_PIN=225508
# Random secret that signs the admin session cookie, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=Sehara
